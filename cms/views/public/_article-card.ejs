<article class="post-card">
  <a class="post-card__media" href="/comunicados/<%= a.slug %>" tabindex="-1" aria-hidden="true">
    <% if (a.cover) { %><img src="<%= a.cover %>" alt="" loading="lazy"><% } else { %><span class="post-card__placeholder"><%- icon('megafone') %></span><% } %>
  </a>
  <div class="post-card__body">
    <p class="eyebrow"><%= a.category || 'Comunicado' %> · <%= fmtDate(a.published_at) %></p>
    <h3 class="post-card__title"><a href="/comunicados/<%= a.slug %>"><%= a.title %></a></h3>
    <% if (a.excerpt) { %><p class="post-card__text"><%= a.excerpt %></p><% } %>
    <a class="text-link" href="/comunicados/<%= a.slug %>">Ler comunicado</a>
  </div>
</article>

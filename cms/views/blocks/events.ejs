<section class="section bg-<%= d.background %>" id="secao-<%= i+1 %>">
  <div class="container">
    <% if (d.title) { %><h2 class="section-title section-title--left"><%= d.title %></h2><% } %>
    <div class="events">
      <% (d.items||[]).forEach(function(it){ %>
      <article class="event">
        <span class="event__icon"><%- icon(it.icon || 'calendario') %></span>
        <div>
          <% if (it.date) { %><p class="eyebrow"><%= it.date %></p><% } %>
          <h3 class="event__title"><%= it.title %></h3>
          <% if (it.text) { %><p class="event__text"><%= it.text %></p><% } %>
          <% if (it.link_label && it.url) { %><a class="text-link" href="<%= it.url %>"<%- linkAttrs(it.url) %>><%= it.link_label %></a><% } %>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

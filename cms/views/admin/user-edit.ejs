<%- include('_head') %>
<div class="content content--narrow">
  <div class="page-title"><div><a class="muted small" href="/admin/usuarios">← Usuários</a><h1><%= u.id ? 'Editar usuário' : 'Novo usuário' %></h1></div></div>
  <% if (error) { %><div class="flash flash--erro"><%= error %></div><% } %>
  <form class="panel" method="post" action="/admin/usuarios/<%= u.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field"><span>Nome</span><input name="name" value="<%= u.name %>" required></label>
    <label class="field"><span>E-mail (usado no login)</span><input type="email" name="email" value="<%= u.email %>" required></label>
    <label class="field"><span>Perfil</span>
      <select name="role"><option value="editor" <%= u.role!=='admin'?'selected':'' %>>Editor — páginas, comunicados e mídia</option><option value="admin" <%= u.role==='admin'?'selected':'' %>>Administrador — acesso total</option></select>
    </label>
    <label class="field"><span><%= u.id ? 'Nova senha (deixe em branco para manter)' : 'Senha inicial (mínimo 8 caracteres)' %></span><input type="password" name="password" minlength="8" <%= u.id ? '' : 'required' %> autocomplete="new-password"></label>
    <label class="check"><input type="checkbox" name="active" <%= u.active ? 'checked' : '' %>> Conta ativa</label>
    <button class="btn btn--primary" type="submit">Salvar usuário</button>
  </form>
</div>
<%- include('_foot') %>

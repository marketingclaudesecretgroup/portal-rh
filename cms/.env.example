# Copie para .env (uso local) ou cadastre em Vercel > Settings > Environment Variables

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-service_role-aqui

# Texto longo e aleatório (ex.: gere em https://1password.com/password-generator)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Opcional: nome do bucket de arquivos (criado automaticamente)
# SUPABASE_BUCKET=portal-rh

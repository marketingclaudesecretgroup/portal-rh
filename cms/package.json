{
  "name": "comunica-secret-cms",
  "version": "1.0.0",
  "description": "Comunica Secret — CMS do portal de Gente & Gestão da Secret Outlet (Vercel + Supabase)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build-sanitizer.js",
    "postinstall": "npm run build",
    "vercel-build": "npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/system.test.js",
    "test:ui": "node --test --test-concurrency=1 tests/browser.test.js",
    "test:runtime": "node --test tests/runtime.test.js",
    "test:uploads": "node --test --test-concurrency=1 tests/uploads.test.js tests/upload-browser.test.js",
    "reset-password": "node scripts/reset-password.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "ejs": "^7.0.2",
    "esbuild": "0.28.2",
    "express": "^5.3.0",
    "express-session": "^1.18.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "quill": "^2.0.3",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
